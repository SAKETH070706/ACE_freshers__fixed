# Server Configuration
PORT=5000
NODE_ENV=development
# BACKEND_URL must be the publicly reachable URL of the backend (or http://localhost:5000 in dev)
BACKEND_URL=http://localhost:5000

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ACE_REG?retryWrites=true&w=majority

# Frontend Allowed Origin(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# Brevo (formerly Sendinblue) Transactional Email API
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@yourdomain.com

# WhatsApp Community / Group Links
WHATSAPP_1ST_YEAR_LINK=https://chat.whatsapp.com/your-1st-year-group-code
WHATSAPP_2ND_YEAR_LINK=https://chat.whatsapp.com/your-2nd-year-group-code

# Optional: Set to true if running behind a corporate/college network requiring public DNS override
USE_CUSTOM_DNS=false
